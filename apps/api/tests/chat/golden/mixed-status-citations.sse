data: {"type":"tool-output-available","toolCallId":"call_pc_1","output":{"question":"Is massage covered and is it a medical expense for tax?","region":"CA","answer":"Whether fees for a practitioner, such as a massage therapist, count as medical expenses depends on the province or territory where the service is provided. (Canada Revenue Agency, \"Authorized medical practitioners for the purposes of the medical expense tax credit\")\n\nThis is general information, not tax or insurance advice.","sources":[{"sourceId":"ca-cra-authorized-practitioners","title":"Authorized medical practitioners for the purposes of the medical expense tax credit","publisher":"Canada Revenue Agency","license":"Crown copyright; non-commercial reproduction permitted"},{"sourceId":"ca-cra-medical-expenses","title":"Lines 33099 and 33199 – Eligible medical expenses you can claim on your tax return","publisher":"Canada Revenue Agency","license":"Crown copyright; non-commercial reproduction permitted"}],"nestedToolCalls":1},"providerExecuted":true}

